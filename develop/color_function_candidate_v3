"""
Third candidate for a color function c(K, P, f) for the 15-coloring
of O_6^*.

Key observations from the previous rounds:
  1. Any proper assignment on the outside vertices must use at least
     fourteen distinct labels (fourteen-clique argument by Zhang-Ma).
  2. Restricting to the seven lines of T is insufficient.
  3. The full inventory of the fifteen distinct nonzero subspaces of
     T is required.
  4. The precise lift values, not just zero/nonzero, must be used.

This candidate:
  - uses the full fifteen-subspace inventory of T;
  - orders the available labels by the precise lift values on a
    canonical basis of P;
  - checks both conditions of the Zhang-Ma criterion.

The criterion (Zhang-Ma):
  1. For U = (K, P, f), the chosen label A must satisfy
     dot(A, P) != 0.
  2. For U = (K, P, f) and W = (L, Q, g) with the same label,
     at least one of X, Y, Z must be nonzero:
       X[a, j] = dot(k_a, q_j)
       Y[i, b] = dot(p_i, l_b)
       Z[i, j] = dot(p_i, q_j) + dot(t_i, q_j) + dot(p_i, u_j).
"""
import json
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def dot(u, v):
    return (u & v).bit_count() % 2


def span(rows):
    result = {0}
    for r in rows:
        result |= {x ^ r for x in list(result)}
    return frozenset(result)


def dim(U):
    return len(U).bit_length() - 1


def basis_of(U):
    basis = []
    for v in sorted(U, reverse=True):
        x = v
        for b in basis:
            x = min(x, x ^ b)
        if x:
            basis.append(x)
            basis.sort(reverse=True)
    return tuple(basis)


def canonical_representative(t, K):
    return min(t ^ k for k in K)


def decompose(u, T, S):
    for s in S:
        if (u ^ s) in T:
            return (u ^ s, s)
    raise ValueError(f"Cannot decompose {u} in T + S")


def lift_data(U, T, S):
    K = U & T
    P_to_f = {}
    for u in U:
        if u == 0:
            continue
        t, s = decompose(u, T, S)
        if s not in P_to_f:
            P_to_f[s] = canonical_representative(t, K)
    if not P_to_f:
        return K, frozenset(), ()
    P = frozenset(P_to_f.keys())
    P_basis = basis_of(P)
    f_values = tuple(P_to_f[s] for s in P_basis)
    return K, P, f_values


T = span([3, 12, 48])

# The 15 distinct nonzero subspaces of T = span{3, 12, 48}.
# Lines (7): span(3), span(12), span(48), span(15), span(51), span(60), span(63)
# Planes (7): span(3,12), span(3,48), span(12,48), span(3,15), span(12,51), span(48,63), span(12,60)
# Whole space (1): T
LINES_T = [
    frozenset({0, 3}),
    frozenset({0, 12}),
    frozenset({0, 48}),
    frozenset({0, 15}),
    frozenset({0, 51}),
    frozenset({0, 60}),
    frozenset({0, 63}),
]

PLANES_T = [
    frozenset(span([3, 12])),
    frozenset(span([3, 48])),
    frozenset(span([12, 48])),
    frozenset(span([3, 15])),
    frozenset(span([12, 51])),
    frozenset(span([48, 63])),
    frozenset(span([12, 60])),
]

# All 15 distinct nonzero subspaces of T
ALL_SUBSPACES_T = LINES_T + PLANES_T + [T]


def availability_score(A, P):
    """
    Return the number of nonzero entries in the A-P pairing matrix.
    Used to order available labels by how strongly they pair with P.
    """
    A_basis = basis_of(A)
    P_basis = basis_of(P) if P else ()
    count = 0
    for a in A_basis:
        for p in P_basis:
            if dot(a, p):
                count += 1
    return count


def candidate_label_v3(U_data):
    """
    Choose a label A from the full fifteen-subspace inventory of T.

    Strategy:
    - Restrict to labels A with nonzero A-P pairing.
    - Order the available labels by the precise lift values on a
      canonical basis of P, using a lexicographic tie-breaker.
    """
    K, P, f = U_data
    if not P:
        # If P = 0, use T itself (fallback).
        return T

    # Restrict to available labels (nonzero A-P pairing)
    available = []
    for A in ALL_SUBSPACES_T:
        if availability_score(A, P) > 0:
            available.append(A)

    if not available:
        return T

    # Use f to build a numeric tie-breaker
    # Combine the lift values into a single integer
    if f:
        # Use all lift values, not just the first
        key = 0
        for i, t in enumerate(f):
            # Use the canonical representative of t in T
            key = (key * 64 + t) % (2 ** 32)
        idx = key % len(available)
        return available[idx]

    return available[0]


def nonzero_matrix_X(K, Q):
    for k in basis_of(K):
        for q in basis_of(Q):
            if dot(k, q):
                return True
    return False


def nonzero_matrix_Y(L, P):
    for p in basis_of(P):
        for l in basis_of(L):
            if dot(p, l):
                return True
    return False


def nonzero_matrix_Z(P, Q, f_values, g_values, K, L):
    P_basis = basis_of(P)
    Q_basis = basis_of(Q)
    for i, p in enumerate(P_basis):
        t_i = canonical_representative(f_values[i], K)
        for j, q in enumerate(Q_basis):
            u_j = canonical_representative(g_values[j], L)
            val = (dot(p, q) + dot(t_i, q) + dot(p, u_j)) % 2
            if val != 0:
                return True
    return False


def are_orthogonal(u1, u2):
    K_U, P_U, f_U = u1
    K_W, P_W, g_W = u2
    if nonzero_matrix_X(K_U, P_W):
        return False
    if nonzero_matrix_Y(K_W, P_U):
        return False
    if nonzero_matrix_Z(P_U, P_W, f_U, g_W, K_U, K_W):
        return False
    return True


def main():
    cert = json.loads((ROOT / 'results/full-15-coloring.json').read_text())
    records = cert['subspace_colors']
    spaces = [span(r['basis']) for r in records]
    S = span([1, 4, 16])

    data = []
    for r, U in zip(records, spaces):
        if U <= T:
            continue
        K, P, f_values = lift_data(U, T, S)
        data.append({
            'U': U,
            'K': K,
            'P': P,
            'f_values': f_values,
            'color': r['color'],
        })

    print(f"Vertices outside the clique: {len(data)}")

    labels = {}
    for d in data:
        labels[d['U']] = candidate_label_v3(
            (d['K'], d['P'], d['f_values']))

    distinct = set(labels.values())
    print(f"Distinct labels used: {len(distinct)}")

    # Condition 1
    bad1 = 0
    for d in data:
        A = labels[d['U']]
        P = d['P']
        ok = False
        for a in basis_of(A):
            for p in basis_of(P):
                if dot(a, p):
                    ok = True
                    break
            if ok:
                break
        if not ok:
            bad1 += 1
    print(f"Condition 1 violations: {bad1}")

    # Condition 2
    by_label = defaultdict(list)
    for d in data:
        by_label[labels[d['U']]].append(d)

    bad2 = 0
    for A, group in by_label.items():
        for i, d1 in enumerate(group):
            for d2 in group[i + 1:]:
                u1 = (d1['K'], d1['P'], d1['f_values'])
                u2 = (d2['K'], d2['P'], d2['f_values'])
                if are_orthogonal(u1, u2):
                    bad2 += 1
    print(f"Condition 2 violations: {bad2}")

    print()
    print("Label distribution:")
    for A, group in sorted(by_label.items(), key=lambda x: -len(x[1])):
        print(f"  Label size {len(A):2d}: {len(group)} vertices")


if __name__ == '__main__':
    main()
